# Copie para .env.local só para rodar no seu computador. Na Vercel, cadastre em
# Settings → Environment Variables. Nunca coloque valores reais no GitHub.

# Obrigatórias para a análise funcionar
GEMINI_API_KEY=
APP_ACCESS_CODE=

# Exigido pela SEC para notícias 8-K e balanços: seu nome e um e-mail de contato
SEC_USER_AGENT=

# Opcional (padrão: gemini-2.5-flash)
GEMINI_MODEL=

# Alternativa: Claude API (usada só se GEMINI_API_KEY estiver vazia)
ANTHROPIC_API_KEY=
VISION_MODEL=

# Preparadas para o login (ainda não usadas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
